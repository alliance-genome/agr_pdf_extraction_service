# =============================================================================
# agr_pdf_extraction_service - Environment Configuration
# =============================================================================
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Most settings have sensible defaults in config.py. Only values you want to
# OVERRIDE need to be set here. Secrets (API keys) are the main exception --
# those MUST be set.
# =============================================================================

# ====================
# Secrets (required)
# ====================

# OpenAI API Key (required for LLM-based merge of extraction outputs)
OPENAI_API_KEY=your_openai_api_key_here

# ABC Literature REST API (requires VPN to Alliance network)
# ABC_API_URL=https://stage-literature-rest.alliancegenome.org
# ABC_API_TOKEN=your_abc_bearer_token_here

# ====================
# Optional overrides
# ====================
# Everything below has defaults in config.py. Uncomment to override.

# ---- Cache versioning ----
# Bump this when extractor config changes to invalidate old cached outputs.
# EXTRACTION_CONFIG_VERSION=7

# ---- GROBID ----
# GROBID_URL=http://localhost:8070         # set by docker-compose
# GROBID_REQUEST_TIMEOUT=120               # seconds
# GROBID_INCLUDE_COORDINATES=true
# GROBID_INCLUDE_RAW_CITATIONS=false
# PDFALTO_TIMEOUT_SECONDS=900              # optional native-style evidence only

# ---- Docling ----
# DOCLING_DEVICE=cpu                       # cpu or auto
# DOCLING_RAPIDOCR_BACKEND=onnxruntime     # OCR backend; onnxruntime supports PP-OCRv6 on CPU
# DOCLING_RAPIDOCR_MODEL_TYPE=medium       # PP-OCRv6 model size: small or medium
# DOCLING_RAPIDOCR_DET_LANG=en             # PP-OCRv6 detector language family: en or ch
# DOCLING_RAPIDOCR_REC_LANG=en             # PP-OCRv6 recognizer language family: en or ch
# DOCLING_RAPIDOCR_USE_CUDA=false          # keep OCR on CPU; Docling layout can still use CUDA

# ---- Marker ----
# MARKER_DEVICE=cpu                        # cpu or auto

# ---- LLM (merge) ----
# SOURCE_SELECTION_MODEL=gpt-5.6-terra
# SOURCE_SELECTION_REASONING=medium
# HARD_SELECTION_MODEL=gpt-5.6-sol
# HARD_SELECTION_REASONING=high
# LLM_OPENAI_TIMEOUT_SECONDS=180         # bounded per-request timeout
# LLM_OPENAI_MAX_RETRIES=1               # bounded SDK transport retries
# LLM_COST_ALERT_USD_PER_JOB=2.0          # log-only alert; never truncates work
# IMAGE_TEXT_REVIEW_MODEL=gpt-5.6-luna   # model for text-only image artifact review
# IMAGE_TEXT_REVIEW_REASONING=medium      # reasoning effort for text-only image review
# PAGE_RESOLUTION_MODEL=gpt-5.6-luna      # fixed model for unresolved page choices
# PAGE_RESOLUTION_REASONING=medium        # fixed reasoning effort for unresolved page choices
# Operational limits (page provenance)
# PAGE_PROVENANCE_LLM_MAX_RANGES_PER_BATCH=24 # residual ranges per bounded Luna request
# PAGE_PROVENANCE_LLM_CONCURRENCY=4 # concurrent page-resolution requests per PDF; use 1 for serial execution or lower to reduce provider load
# PAGE_PROVENANCE_LLM_CONTEXT_BYTES=512   # immediate UTF-8 source-context byte bound per side
# PAGE_PROVENANCE_LLM_EVIDENCE_BYTES_PER_RANGE=4096 # residual-text chunk and alternative-excerpt byte bound per range

# PDFX_BENCHMARK_MODE=false               # verbose content-free decision/timing evidence for isolated corpus runs

# ---- Storage ----
# CACHE_FOLDER=/app/data/cache
# UPLOAD_FOLDER=/app/data/uploads
# MAX_CONTENT_LENGTH=104857600             # 100MB
# DATABASE_URL=postgresql://pdfx:pdfx@localhost:5432/pdfx

# ---- S3 audit + artifact retention ----
# On EC2: bucket name is read from SSM Parameter Store (/pdfx/audit-s3-bucket).
# For local dev: set AUDIT_S3_BUCKET directly.
# AUDIT_S3_BUCKET=agr-pdf-extraction-benchmark
# AUDIT_S3_PREFIX=pdfx/audit
# AUDIT_FLUSH_ON_EVENT=true               # keep partial audit logs durable during long runs
# IMAGE_URL_TTL_SECONDS=3600
# IMAGE_RETENTION_TTL_SECONDS=604800
# AWS_DEFAULT_REGION=us-east-1

# ---- Celery / Redis ----
# Operational limits
# AMI provisioner only (not loaded from the application .env during Packer).
# Per-fixture worker deadline; increase for slow model downloads.
# Packer override: PKR_VAR_bake_warmup_timeout_seconds=600
# PDFX_BAKE_WARMUP_TIMEOUT_SECONDS=600
# Submission HTTP timeout; increase for slow local API startup.
# Packer override: PKR_VAR_bake_http_timeout_seconds=30
# PDFX_BAKE_HTTP_TIMEOUT_SECONDS=30
# CELERY_BROKER_URL=redis://localhost:6379/0    # set by docker-compose
# CELERY_RESULT_BACKEND=redis://localhost:6379/1 # set by docker-compose
# SUBMISSION_CLAIM_STALE_SECONDS=120              # reclaim a crashed pre-publish DB claim after this bound
# TERMINAL_STATE_RETRY_DELAY_SECONDS=30           # fail-closed delay; retry until authoritative terminal state commits
# TASK_REJECT_ON_WORKER_LOST=true                 # requeue late-ack work when its worker process disappears
# TASK_SOFT_TIME_LIMIT_SECONDS=1800              # recovery stops before this limit
# TASK_HARD_TIME_LIMIT_SECONDS=2100              # Celery hard kill
# EXTRACTION_FINALIZATION_RESERVE_SECONDS=300    # never spend this reserve on recovery
# HEALTH_BUSY_RUN_MAX_AGE_SECONDS=21600         # max running-row age that can downgrade workers=0 to busy/degraded

# Operational limits (durable pipeline)
# Isolated per-attempt caches replace shared hash caches; every job re-extracts.
# Empty bucket reuses AUDIT_S3_BUCKET (or its configured SSM lookup).
PIPELINE_S3_BUCKET=
PIPELINE_S3_PREFIX=pdfx/pipeline
# PIPELINE_WORKSPACE=/app/data/pipeline
# PIPELINE_HEALTH_DIRECTORY=/app/data/cache/pipeline-health
PIPELINE_FINALIZERS=2                  # CPU merge processes; tune against RAM and GPU contention
PIPELINE_DOWNSTREAM_CAP=4              # admitted extraction + unfinished finalization; bounds backlog
PIPELINE_PROVIDER_CONCURRENCY=4        # global in-flight SDK calls across finalizers
PIPELINE_LEASE_SECONDS=60              # recovery only after stale heartbeat and released ownership lock
PIPELINE_REPUBLISH_SECONDS=30          # retry broker notification for an unclaimed durable stage
PIPELINE_MAX_ATTEMPTS=2                # safe-stage attempts; uncertain provider work is never replayed
PIPELINE_DEADLINE_SECONDS=2100         # first extraction claim through both stages/retries; no per-stage reset
PIPELINE_QUEUE_MAX_AGE_SECONDS=86400   # maximum backend wait before first claim; raise for deliberately long batches
PIPELINE_CHECKPOINT_MAX_BYTES=2147483648 # total immutable checkpoint byte bound
PIPELINE_CHECKPOINT_MAX_FILES=10000     # protects restoration from oversized manifests
PIPELINE_MANIFEST_MAX_BYTES=8388608     # maximum checkpoint JSON bytes
PIPELINE_HEALTH_MAX_AGE_SECONDS=20      # dispatcher/worker liveness freshness
PIPELINE_DB_TIMEOUT_SECONDS=10         # DB connection, statement and keepalive detection bounds
PDFX_FINALIZER_CPUS=4.0                # total CPU ceiling for CPU worker pool
PDFX_FINALIZER_MEMORY=8g               # total RAM ceiling for CPU worker pool
PDFX_FINALIZER_THREADS=2               # BLAS/OpenMP threads per finalizer
PDFX_DISPATCHER_CPUS=1.0               # lightweight dispatch process CPU ceiling
PDFX_DISPATCHER_MEMORY=1g              # dispatch process memory ceiling

# Operational limits (Sentry)
SENTRY_ENABLED=true                   # kill switch; an empty DSN also disables reporting
SENTRY_DSN=                           # inject the dedicated PDFX dev or prod project secret
SENTRY_ENVIRONMENT=local              # lab/dev/production; distinct project DSNs isolate dev/prod
SENTRY_RELEASE=pdfx@unknown            # immutable deployed image SHA
SENTRY_ALLOW_INSECURE_DSN=false        # true only for approved private/VPC HTTP ingestion
SENTRY_TRACES_SAMPLE_RATE=0.1          # sampled stage/request timing; 0 disables traces
SENTRY_SHUTDOWN_TIMEOUT_SECONDS=2      # bounded SDK drain on process exit

PIPELINE_GPU_ADMISSIONS=1             # queued/running extraction admissions; one solo GPU worker executes them
SENTRY_DISPATCHER_ERROR_INTERVAL_SECONDS=300 # coalesce repeated dispatch outage errors; successes reset suppression

# Optional Compose overlay for explicitly isolated test/bake deployments.
# PDFX_DEPLOY_COMPOSE_OVERRIDE=/absolute/path/to/overlay.yml

# Alternative to a direct DSN: use the container/instance IAM role to read one
# runtime secret. Set the project explicitly; dev/prod never share an ingest key.
SENTRY_RUNTIME_SECRET_ID=
SENTRY_PROJECT=
SENTRY_SECRET_TIMEOUT_SECONDS=2        # connect/read bound for optional reporting secret lookup
SENTRY_SECRET_MAX_ATTEMPTS=1           # total lookup attempts; raise only if startup delay is acceptable
PIPELINE_DISPATCH_BATCH_SIZE=100       # max rows locked per dispatcher pass; active stages take precedence
PIPELINE_ERROR_MESSAGE_MAX_CHARS=1000  # maximum terminal error text retained in the status DB
PIPELINE_WATCHDOG_STARTUP_SECONDS=30   # fail closed if the external ownership/deadline monitor cannot start

# Operational limits (proxy durable artifact delivery)
ARTIFACT_S3_BUCKET=                   # set to backend AUDIT_S3_BUCKET; required for downloads
ARTIFACT_S3_PREFIX=pdfx/audit          # allowed receipt namespace; match backend AUDIT_S3_PREFIX
ARTIFACT_S3_TIMEOUT_SECONDS=10        # per connect/read timeout; tune for storage latency
ARTIFACT_S3_MAX_ATTEMPTS=2            # total S3 attempts; bounds retry latency
ARTIFACT_STREAM_CHUNK_BYTES=65536     # per-read buffer; tune throughput vs memory
ARTIFACT_URL_TTL_SECONDS=3600         # audit/artifact signed URL lifetime
# IMAGE_URL_TTL_SECONDS=3600          # image manifest URL lifetime (same backend setting)
# IMAGE_RETENTION_TTL_SECONDS=604800  # advertised S3 lifecycle retention (same backend setting)
